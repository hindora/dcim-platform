# Copy to deploy/.env and fill in. deploy/.env is gitignored and must stay that
# way: it holds the key that decrypts every stored device credential.
#
# Generate the secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"          # JWT / tokens
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"  # credential key

POSTGRES_USER=dcim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dcim

REDIS_PASSWORD=change-me

# Signs user JWTs.
DCIM_JWT_SECRET=change-me

# Separate credential type from user JWTs: the assignments endpoint returns
# decrypted device credentials, so a browser token must never open it.
DCIM_COLLECTOR_TOKEN=change-me

# base64 of exactly 32 bytes. Losing or rotating this without re-encrypting
# makes every stored device credential unreadable.
DCIM_CREDENTIAL_KEY=change-me

# Phase 1 has no user table; this is the single login until phase 4.
DCIM_ADMIN_USER=admin
DCIM_ADMIN_PASSWORD=change-me

# Simulator, for the seed importer.
DCIM_SIMULATOR_BASE_URL=http://host.docker.internal:8001
DCIM_SIMULATOR_USERNAME=admin
DCIM_SIMULATOR_PASSWORD=
# The gNMI server is one process serving every target, so its host is a
# deployment fact rather than a device attribute.
DCIM_GNMI_SERVER_HOST=127.0.0.1
