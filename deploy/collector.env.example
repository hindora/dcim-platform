# Copy to /etc/dcim/collector.env (root-owned, mode 0640) and fill in.
# Read by systemd's EnvironmentFile= - see collector.service - and equally
# valid as a container's --env-file or a Kubernetes Secret's data.

# The id chosen in Settings > Collectors > Add collector. Must match exactly:
# it is embedded in the token below and the platform refuses a mismatch.
DCIM_COLLECTOR_ID=col-dc2-oob

# Where this platform is reachable from this collector's network. Same value
# the browser uses, not localhost - a collector is never on the same host as
# the platform in a real deployment.
DCIM_BASE_URL=https://dcim.example.com

# Issued once, on creation or from Settings > Collectors > Manage > Issue new
# token. The platform keeps no copy - if this is lost, issue a new one; the
# old one stops working within about fifteen seconds.
DCIM_COLLECTOR_TOKEN=

# As of this release the collector writes telemetry straight to the
# platform's Redis (docs/26 Phase 3, an authenticated ingest gateway over
# 443, is not built yet) - so a real remote-site deployment needs a route
# from here to Redis, over a VPN or private link, never the open internet.
# The default in collector.yaml is a local instance; override it if this
# collector is not core-hosted.
# DCIM_REDIS_URL=redis://:password@core-redis.internal:6379/0
